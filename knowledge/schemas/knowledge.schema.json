{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalforge.local/schemas/knowledge.schema.json",
  "title": "GoalForge Knowledge Graph",
  "type": "object",
  "properties": {
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    },
    "goals": {
      "type": "array",
      "items": { "$ref": "#/$defs/goal" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["id", "name", "domain", "description", "prerequisites", "difficulty"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "difficulty": { "enum": ["beginner", "intermediate", "advanced"] }
      },
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "required": ["id", "name", "description", "required_skills"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "required_skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
